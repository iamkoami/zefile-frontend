# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'strict-dynamic'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.zefile.io https://api-dev.zefile.io https://*.wasabisys.com; media-src 'self' blob: https://api.zefile.io https://api-dev.zefile.io https://*.wasabisys.com; connect-src 'self' https://api.zefile.io https://api-dev.zefile.io https://*.wasabisys.com https://app.posthog.com https://eu.i.posthog.com https://us.i.posthog.com; font-src 'self'; frame-src https://checkout.paystack.com https://www.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Block all .pages.dev URLs from search engines
# This includes main deployments and preview deployments (commit-based URLs)
*.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Main production deployment redirect
https://zefile-frontend.pages.dev/*
  X-Robots-Tag: noindex
  ! Host: zefile-frontend.pages.dev
  Location: https://zefile.io/:splat 301

# Main staging deployment redirect
https://zefile-dev.pages.dev/*
  X-Robots-Tag: noindex
  ! Host: zefile-dev.pages.dev
  Location: https://demo.zefile.io/:splat 301
